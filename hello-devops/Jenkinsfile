pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
    }

    post {
        success {
            slackSend(channel: '#jenkins', color: 'good', message: "Build SUCCESSFUL for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
        }
        failure {
            slackSend(channel: '#jenkins', color: 'danger', message: "Build FAILED for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
        }
    }
}
